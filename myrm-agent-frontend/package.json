{
  "name": "myrm-agent-frontend",
  "version": "0.1.0",
  "private": true,
  "sideEffects": [
    "*.css",
    "*.scss",
    "src/app/globals.css"
  ],
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "dev:lan": "WEBUI_DEV_BIND_ALL=1 bun run scripts/dev.ts",
    "dev:clean": "bun run scripts/dev.ts --clean",
    "cleanup": "bun run scripts/cleanup.ts",
    "i18n:split": "node scripts/split-locale-namespaces.mjs",
    "build:sw-inject": "node scripts/build-sw-src.mjs",
    "build": "bun run i18n:split && next build && bun run build:sw-inject && NODE_ENV=production bunx serwist inject-manifest serwist.config.ts && node scripts/verify-sw-push.mjs && rm -f package-lock.json",
    "build:tauri": "bun run i18n:split && BUILD_MODE=tauri next build",
    "prestart": "bun run i18n:split",
    "start": "next start",
    "lint": "bun scripts/run-lint-gates.ts",
    "lint:oxlint": "bun node_modules/oxlint/bin/oxlint --ignore-path .oxlintignore",
    "lint:fix": "bun node_modules/oxlint/bin/oxlint --ignore-path .oxlintignore --fix",
    "lint:watch": "watch 'bun run lint' src",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "check": "bun run format && bun run lint",
    "typecheck": "tsc --noEmit",
    "generate:artifact-types": "bun scripts/generate-artifact-types.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "verify:i18n": "bun scripts/verify-i18n.mjs && bun scripts/verify-i18n-references.mjs",
    "verify:stable-mocks": "bun scripts/verify-stable-mocks.mjs",
    "verify:orphans": "bun scripts/check-orphan-modules.mjs",
    "verify:orphans:diff": "bun scripts/check-orphan-modules.mjs --base origin/main",
    "verify:a11y": "bun scripts/check-a11y-ratchet.mjs",
    "verify:theme-colors": "bun scripts/check-theme-colors.mjs",
    "verify:reduced-motion": "bun scripts/check-reduced-motion.mjs",
    "verify:hardcoded-copy": "bun scripts/check-hardcoded-copy.mjs",
    "verify:icu-syntax": "bun scripts/check-icu-syntax.mjs",
    "verify:intl-options": "bun scripts/check-ignored-intl-options.mjs",
    "verify:provider-icons": "vitest run src/components/features/settings/model-service/__tests__/",
    "pretest": "bun run i18n:split && bun scripts/generate-simplified-glyphs.mjs --check && bun run verify:i18n && bun run verify:stable-mocks && bun run verify:provider-icons"
  },
  "dependencies": {
    "@aiden0z/pptx-renderer": "^1.4.0",
    "@codesandbox/sandpack-react": "^2.20.0",
    "@codesandbox/sandpack-themes": "^2.0.21",
    "@dagrejs/dagre": "^3.1.3",
