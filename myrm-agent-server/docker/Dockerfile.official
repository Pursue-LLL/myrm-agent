# Official Myrm Runtime Image — server + harness built from this repository
#
# BUILD CONTEXT (required): the myrm-agent repository root (`.`), which contains
# `myrm-agent-harness/`, `myrm-agent-server/`, and `shared/`.
#
#   docker build -f myrm-agent-server/docker/Dockerfile.official -t myrm/runtime:local .

# ============================================================================
# Stage 1: Build the harness wheel (single pure-Python wheel, same as PyPI)
# ============================================================================
FROM python:3.13-slim AS harness-wheel

ENV PYTHONUNBUFFERED=1

COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

WORKDIR /build/myrm-agent-harness

COPY myrm-agent-harness/pyproject.toml myrm-agent-harness/README.md myrm-agent-harness/LICENSE ./
COPY myrm-agent-harness/src ./src

RUN uv build --wheel -o /wheels

# ============================================================================
# Stage 2: Build server venv; harness is installed from the wheel above
# ============================================================================
FROM python:3.13-slim AS builder

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_COMPILE_BYTECODE=1

COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential gcc libolm-dev \
    && rm -rf /var/lib/apt/lists/*

COPY --from=harness-wheel /wheels /wheels

WORKDIR /build/myrm-agent-server

COPY myrm-agent-server/pyproject.toml myrm-agent-server/uv.lock ./
COPY myrm-agent-server/app ./app
COPY myrm-agent-server/run.py ./run.py

ENV PATCHRIGHT_SKIP_BROWSER_DOWNLOAD=1 \
    PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1

# uv.lock resolves the harness as an editable path source; the image installs its wheel instead,
# so every harness dependency still comes from the lock while the harness itself is not editable.
RUN --mount=type=cache,target=/root/.cache/uv \
    uv venv \
    && uv sync --frozen --no-dev --all-extras --no-install-project --no-install-package myrm-agent-harness \
    && uv pip install --no-deps /wheels/myrm_agent_harness-*.whl

# ============================================================================
# Stage 3: Runtime
# ============================================================================
FROM python:3.13-slim AS runtime

LABEL maintainer="MyrmAgent"
LABEL description="MyrmAgent Official Runtime - Server + harness"

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    DEPLOY_MODE=local \
    PORT=25808 \
    HOST=0.0.0.0 \
    MPLBACKEND=Agg \
    MATPLOTLIBRC=/opt/mpl-config/matplotlibrc \
    MPLCONFIGDIR=/tmp/matplotlib

RUN groupadd -r myrm && useradd -r -g myrm -m -d /home/myrm myrm

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl ca-certificates xvfb x11vnc novnc websockify fluxbox \
    scrot xdotool at-spi2-core dbus-x11 tini \
    fontconfig fonts-noto-cjk fonts-noto-color-emoji fonts-liberation \
    && fc-cache -f \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /build/myrm-agent-server/.venv /app/.venv
COPY --from=builder /build/myrm-agent-server/app /app/app
COPY --from=builder /build/myrm-agent-server/run.py /app/run.py
COPY myrm-agent-server/docker/entrypoint.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh

COPY myrm-agent-server/docker/sandbox/matplotlibrc /opt/mpl-config/matplotlibrc
COPY shared /shared

RUN /app/.venv/bin/verify-harness-distribution --matplotlib-cjk \
    && rm -rf /tmp/_mpl_verify.png /tmp/matplotlib

WORKDIR /app
RUN mkdir -p /home/myrm/.myrm-agent && chown -R myrm:myrm /home/myrm /app

USER myrm

ENV PATH="/app/.venv/bin:$PATH" VIRTUAL_ENV="/app/.venv"

EXPOSE 25808 6080

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD curl -f http://localhost:25808/health || exit 1

ENTRYPOINT ["/usr/bin/tini", "-g", "--", "/app/entrypoint.sh"]
CMD ["python", "run.py", "--skip-port-check", "--host", "0.0.0.0", "--port", "25808"]
