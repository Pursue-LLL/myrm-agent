# MyrmAgent Server — dev/test only [T]
# =============================================================================
# POLICY:
#   • ONLY for local pytest / E2E development — server production NEVER reads this file.
#   • Loaded exclusively by tests/support/test_secrets.py (via tests/conftest.py).
#   • Business-tier keys here (BASIC_*, LITE_*, SEARCH_*) simulate WebUI providers in tests.
#     Production business config MUST come from WebUI Settings (DB) + inject.
# =============================================================================
# Copy: cp .env.test.example .env.test

# =============================================================================
# [T] LLM providers — pytest/E2E only (mirrors WebUI provider rows, not server env)
# =============================================================================

# BASIC_API_KEY=
# BASIC_BASE_URL=
# BASIC_MODEL=
# LITE_API_KEY=
# LITE_BASE_URL=
# LITE_MODEL=

# MODEL string format: `<route>/<model id>`.
#   • <route> is the BACKEND transport route (provider_routing.py in the harness), NOT the WebUI provider id.
#     Providers with their own route are written by name: `minimax/MiniMax-M3.1-Flash-Preview`.
#     An OpenAI-compatible endpoint with no preset in the WebUI uses the `openai-like/` alias (resolves to the
#     `openai` route); BASE_URL and API_KEY are always passed explicitly, and the WebUI needs a matching custom
#     OpenAI-compatible provider.
#   • Presets that reuse the `openai` route can be named here only when aliased in
#     normalize_env_model_selection_string (provider_routing.py): `siliconflow/` and `opencode_go/` today. The other
#     presets (vercel_ai_gateway, nvidia, ai302, spark) have no alias: do not write their ids here.
#     Configure the PRESET provider in WebUI Settings (providerTypes.ts) and do not add a custom provider with the
#     same API URL.
#   • LIVE Chrome E2E reuses the first segment as the seeded WebUI provider id (e2e_provider_seed.py
#     infer_provider_id): `openai-like` creates a separate custom provider, while `openai` would replace the
#     built-in OpenAI row for the run (the seed snapshots and restores provider config on exit).
#   • There is no reasoning-effort variable: effort is a request parameter (WebUI thinking-intensity control).
#     Its default `Auto` sends nothing, so the model's own default applies; only a chosen level or `Off` is sent.
# Standby blocks may be kept commented; BASIC_*/LITE_* are plain variables, so enable only ONE block at a time.

# OmniRoute Agnes combo (3-account fill-first): BASIC via localhost:20128 + openai-like/agnes-2.5-flash
# LIVE E2E: when BASIC/LITE use localhost:20128, resolve_e2e_llm_endpoints preflights the gateway and
# fails fast if OmniRoute is down or BASIC_API_KEY is rejected (no silent fallback).

# =============================================================================
# [T] Search services (business tier — pytest only)
# =============================================================================

# SEARCH_SERVICE=tavily
# TAVILY_API_KEY=
# SEARXNG_URL=http://localhost:8888
# SEARXNG_ENGINE=general

# =============================================================================
# [T] Embedding (business tier — pytest only)
# =============================================================================

# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=
# EMBEDDING_PROVIDER=

# =============================================================================
# [T] OAuth & E2E URLs
# =============================================================================

# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# BACKEND_URL=http://localhost:8080
# TEST_BASE_URL=http://localhost:8080
# TEST_USERNAME=
# TEST_PASSWORD=

# =============================================================================
# [T] Test harness toggles (optional)
# =============================================================================

# PYTEST_CURRENT_TEST — set automatically by pytest; do not add to this file

# RUN_E2E_TESTS=1
# RUN_OPENAI_COMPAT_E2E=1
# MYRM_E2E_ARCHIVE_CHECKPOINT=1
# MYRM_SMOKE_BASE_URL=
# MYRM_SMOKE_API_KEY=
# MYRM_SMOKE_RUN_ID=
# MYRM_SMOKE_ENABLE_CHAT_RECALL=1
# MYRM_DATA_DIR=

# =============================================================================
# [T] Optional test fallbacks (embedding E2E helpers only — not server runtime)
# =============================================================================

# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# =============================================================================
# [T] Optional third-party service credentials (credential-gated E2E only)
# =============================================================================

# Postiz positive Lane-C chain (tests/e2e/test_postiz_agent_draft_lane_c_chrome_e2e.py):
# without it the test skips. Requires a Postiz API key plus at least one
# social channel already connected inside Postiz.
# POSTIZ_API_KEY=

# =============================================================================
# [T] Complete test env index (pytest only — mirrors WebUI business config for E2E)
# =============================================================================
# LLM: BASIC_API_KEY, BASIC_BASE_URL, BASIC_MODEL, LITE_API_KEY, LITE_BASE_URL, LITE_MODEL
# Search: SEARCH_SERVICE, TAVILY_API_KEY, SEARXNG_URL, SEARXNG_ENGINE
# Embedding: EMBEDDING_MODEL, EMBEDDING_API_KEY, EMBEDDING_BASE_URL, EMBEDDING_PROVIDER
# OAuth: GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET
# URLs: BACKEND_URL, TEST_BASE_URL
# Auth: TEST_USERNAME, TEST_PASSWORD
# Toggles: RUN_E2E_TESTS, RUN_OPENAI_COMPAT_E2E, MYRM_E2E_* , MYRM_SMOKE_*
# Workspace: MYRM_DATA_DIR (isolated by tests/conftest.py in unit tests)
# Fallbacks: OPENAI_API_KEY, ANTHROPIC_API_KEY (embedding E2E helpers only)
